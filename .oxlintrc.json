{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "bun:test",
            "message": "Import test APIs from @effect/vitest. Run tests with bun run test."
          },
          {
            "name": "vitest",
            "message": "Import test APIs from @effect/vitest so Effect tests use the scoped runner."
          }
        ]
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "ignorePatterns": [
    "repos/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "**/coverage/**",
    "**/target/**",
    "apps/desktop/src-tauri/gen/**",
    "apps/site/.astro/**",
    "**/.alchemy/**",
    "apps/site/src/content/docs/docs/api/**",
    "apps/site/src/content/docs/docs/packages/**"
  ]
}
