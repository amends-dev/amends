---
// A marketing page: the document around a page component, with the fonts, the site's document
// theme, and the reader's mode chosen before anything paints, as the documentation's pages do.
import "@amends-dev/ui/foundations/typography/fonts";
import "@amends-dev/ui/site/fonts";
import "@amends-dev/ui/site/document";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      // Starlight keeps the reader's choice under this key, empty for "follow the system".
      let stored = "";
      try {
        stored = localStorage.getItem("starlight-theme") ?? "";
      } catch {}
      document.documentElement.dataset.theme =
        stored === "light" || stored === "dark"
          ? stored
          : matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
