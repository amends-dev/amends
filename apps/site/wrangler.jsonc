{
  // amends.dev on Cloudflare Workers: the static build in dist, served as assets with no Worker
  // code. `bun run deploy` builds and uploads it; the custom domain is set in Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amends-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
