{
  "name": "@amends/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:frontend": "bun run --bun vite",
    "build:frontend": "bun run typecheck && bun run --bun vite build",
    "preview": "bun run --bun vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:native": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "test": "bun run --bun vitest run --config vite.config.ts"
  },
  "dependencies": {
    "@amends/client": "workspace:*",
    "@amends/icons": "workspace:*",
    "@amends/ui-v2": "workspace:*",
    "@solidjs/router": "catalog:",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.9",
    "@tauri-apps/cli": "2.11.5",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "effect": "catalog:",
    "happy-dom": "^20.10.6",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
