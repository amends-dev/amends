{
  "name": "@amends/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css.ts",
    "**/*.css",
    "./src/styles/index.ts",
    "./src/styles/fonts.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./tokens": "./src/tokens/index.ts",
    "./styles": "./src/styles/index.ts",
    "./vars": "./src/styles/contract.css.ts",
    "./typography": "./src/styles/type.css.ts",
    "./fonts": "./src/styles/fonts.ts",
    "./components": "./src/components/index.ts"
  },
  "scripts": {
    "build": "bun run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint ./src ./test ./vite.config.ts",
    "lint:fix": "oxlint --fix --quiet ./src ./test ./vite.config.ts",
    "format": "oxfmt --check --no-error-on-unmatched-pattern \"./src/**/*.{ts,tsx}\" \"./test/**/*.{ts,tsx}\"",
    "format:fix": "oxfmt --write --no-error-on-unmatched-pattern \"./src/**/*.{ts,tsx}\" \"./test/**/*.{ts,tsx}\"",
    "test": "bun run --bun vitest run --config vite.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@solid-primitives/event-listener": "catalog:",
    "@solid-primitives/resize-observer": "catalog:",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/recipes": "^0.5.7"
  },
  "devDependencies": {
    "@effect/atom-solid": "catalog:",
    "@solidjs/testing-library": "^0.8.9",
    "@testing-library/user-event": "^14.6.7",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "effect": "catalog:",
    "happy-dom": "^20.10.6",
    "solid-js": "^1.9.12",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "solid-js": "^1.9.12"
  }
}
