{
  "name": "@amends/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css.ts",
    "**/*.css",
    "./src/foundations/typography/fonts.ts"
  ],
  "exports": {
    "./foundations/color": "./src/foundations/color/tokens.ts",
    "./foundations/color/styles": "./src/foundations/color/theme.css.ts",
    "./foundations/focus": "./src/foundations/focus/tokens.ts",
    "./foundations/focus/styles": "./src/foundations/focus/styles.css.ts",
    "./foundations/radius": "./src/foundations/radius/tokens.ts",
    "./foundations/spacing": "./src/foundations/spacing/tokens.ts",
    "./foundations/typography": "./src/foundations/typography/tokens.ts",
    "./foundations/typography/styles": "./src/foundations/typography/styles.css.ts",
    "./foundations/typography/fonts": "./src/foundations/typography/fonts.ts",
    "./primitives/text": "./src/primitives/text/index.ts",
    "./primitives/button": "./src/primitives/button/index.ts",
    "./primitives/input": "./src/primitives/input/index.ts",
    "./compositions/field": "./src/compositions/field/index.ts",
    "./primitives/radio": "./src/primitives/radio/index.ts",
    "./compositions/radio-group": "./src/compositions/radio-group/index.ts",
    "./primitives/checkbox": "./src/primitives/checkbox/index.ts",
    "./primitives/switch": "./src/primitives/switch/index.ts",
    "./primitives/select": "./src/primitives/select/index.ts"
  },
  "scripts": {
    "dev": "bun run --bun storybook dev --host 127.0.0.1 --port 6007 --no-open --disable-telemetry",
    "build": "bun run typecheck && bun run --bun storybook build --output-dir dist --disable-telemetry",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run --bun vitest run --config vite.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@vanilla-extract/css": "^1.21.2"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.9",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "colorjs.io": "0.7.1",
    "happy-dom": "^20.10.6",
    "solid-js": "^1.9.12",
    "storybook": "10.6.0",
    "storybook-solidjs-vite": "10.7.2",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "solid-js": "^1.9.12"
  }
}
