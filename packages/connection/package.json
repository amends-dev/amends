{
  "name": "@amends-dev/connection",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "update-models": "bun run scripts/update-models.ts"
  },
  "dependencies": {
    "@amends-dev/channel": "workspace:*",
    "@amends-dev/harness": "workspace:*",
    "@amends-dev/sandbox": "workspace:*",
    "@amends-dev/toolkit": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
