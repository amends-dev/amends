  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saribmah/amends-v2.git",
    "directory": "packages/sandbox"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/conformance/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
