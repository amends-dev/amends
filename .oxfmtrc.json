{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "trailingComma": "none",
  "arrowParens": "always",
  "sortImports": {
    "newlinesBetween": false
  },
  "ignorePatterns": [
    "repos/**",
    "adapters/*/drizzle/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "**/coverage/**",
    "bun.lock",
    "**/target/**",
    "apps/site/.astro/**",
    "**/.alchemy/**",
    "apps/site/src/content/docs/docs/api/**",
    "apps/site/src/content/docs/docs/packages/**"
  ]
}
