{
  "name": "amends",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "adapters/*",
      "hosts/*",
      "apps/*",
      "examples"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.5",
      "@effect/platform-browser": "4.0.5",
      "@effect/platform-node": "4.0.5",
      "@effect/sql-pg": "4.0.5",
      "effect": "4.0.5",
      "@effect/atom-solid": "4.0.5",
      "@solidjs/router": "0.15.4",
      "@effect/vitest": "4.0.5",
      "@effect/ai-anthropic": "4.0.5",
      "@effect/ai-openai": "4.0.5",
      "@effect/ai-openai-compat": "4.0.5",
      "@daytona/sdk": "0.223.1",
      "@vercel/sandbox": "3.8.0",
      "@anthropic-ai/claude-agent-sdk": "0.3.302",
      "@anthropic-ai/sdk": "0.135.0",
      "e2b": "2.56.0",
      "alchemy": "2.0.0-beta.81",
      "@opencode/codemode": "2.0.32"
    }
  },
  "type": "module",
  "scripts": {
    "start": "bun run --filter @amends-dev/host-local start",
    "dev": "bun run --filter @amends-dev/host-local dev",
    "typecheck": "tsc --noEmit && bun run --workspaces typecheck",
    "test": "bun run --bun vitest run",
    "check:packages": "bun run scripts/check-packages.ts",
    "barrels": "bun run scripts/barrels.ts",
    "check:barrels": "bun run scripts/barrels.ts --check",
    "dist": "bun run scripts/dist.ts",
    "changeset-version": "bun run scripts/changeset-version.ts",
    "changeset-publish": "bun run dist build && changeset publish",
    "check:icons": "bun run --filter @amends-dev/icons check:generated",
    "lint": "oxlint --disable-nested-config --deny-warnings .",
    "lint:fix": "oxlint --disable-nested-config --fix --deny-warnings .",
    "format": "oxfmt --config .oxfmtrc.json --write .",
    "format:check": "oxfmt --config .oxfmtrc.json --check .",
    "check": "bun run check:packages && bun run check:barrels && bun run check:icons && bun run typecheck && bun run lint && bun run format:check",
    "prepare": "effect-tsgo patch && lefthook install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@changesets/read": "1.0.1",
    "@effect/docgen": "4.0.5",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "catalog:",
    "@testing-library/jest-dom": "7.0.1",
    "@types/bun": "latest",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@effect/platform-browser": "catalog:",
    "effect": "catalog:",
    "vite-node": "5.0.0"
  },
  "patchedDependencies": {
    "foldkit@0.168.0-canary.bfd880b1e6ca": "patches/foldkit@0.168.0-canary.bfd880b1e6ca.patch"
  }
}
