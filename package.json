{
  "name": "amends-v2",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "adapters/*",
      "hosts/*",
      "apps/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0-rc.115",
      "@effect/sql-sqlite-bun": "4.0.0-rc.115",
      "@effect/sql-pg": "4.0.0-rc.115",
      "effect": "4.0.0-rc.115",
      "@effect/atom-react": "4.0.0-rc.115",
      "@effect/atom-solid": "4.0.0-rc.115",
      "@solidjs/router": "0.15.4",
      "@solidjs/meta": "0.29.4",
      "@solid-primitives/event-listener": "2.4.5",
      "@solid-primitives/keyed": "1.5.3",
      "@solid-primitives/map": "0.7.4",
      "@solid-primitives/resize-observer": "2.1.5"
    }
  },
  "type": "module",
  "scripts": {
    "start": "bun run --filter @amends/host-local start",
    "dev": "bun run --filter @amends/host-local dev",
    "typecheck": "tsc --noEmit && bun run --workspaces typecheck",
    "test": "bun test packages/core/test packages/server-http/test adapters/storage-postgresql/test hosts/local/test && bun run --filter @amends/ui test && bun run --filter @amends/web test",
    "check:packages": "bun run scripts/check-packages.ts",
    "lint": "oxlint --disable-nested-config --deny-warnings .",
    "lint:fix": "oxlint --disable-nested-config --fix --deny-warnings .",
    "format": "oxfmt --config .oxfmtrc.json --write .",
    "format:check": "oxfmt --config .oxfmtrc.json --check .",
    "check": "bun run check:packages && bun run typecheck && bun run lint && bun run format:check",
    "prepare": "effect-tsgo patch && lefthook install"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@types/bun": "latest",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
