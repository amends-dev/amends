{
  "name": "amends-v2",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "adapters/*",
      "hosts/*",
      "apps/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0-rc.115",
      "@effect/sql-pg": "4.0.0-rc.115",
      "effect": "4.0.0-rc.115",
      "@effect/atom-solid": "4.0.0-rc.115",
      "@solidjs/router": "0.15.4",
      "@effect/vitest": "4.0.0-rc.115",
      "@effect/ai-anthropic": "4.0.0-rc.115",
      "@effect/ai-openai-compat": "4.0.0-rc.115"
    }
  },
  "type": "module",
  "scripts": {
    "start": "bun run --filter @amends/host-local start",
    "dev": "bun run --filter @amends/host-local dev",
    "typecheck": "tsc --noEmit && bun run --workspaces typecheck",
    "test": "bun run --bun vitest run",
    "check:packages": "bun run scripts/check-packages.ts",
    "check:icons": "bun run --filter @amends/icons check:generated",
    "lint": "oxlint --disable-nested-config --deny-warnings .",
    "lint:fix": "oxlint --disable-nested-config --fix --deny-warnings .",
    "format": "oxfmt --config .oxfmtrc.json --write .",
    "format:check": "oxfmt --config .oxfmtrc.json --check .",
    "check": "bun run check:packages && bun run check:icons && bun run typecheck && bun run lint && bun run format:check",
    "prepare": "effect-tsgo patch && lefthook install"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "catalog:",
    "@testing-library/jest-dom": "7.0.1",
    "@types/bun": "latest",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "vite-node": "5.0.0"
  }
}
